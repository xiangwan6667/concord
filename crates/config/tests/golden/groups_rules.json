{
  "port": 0,
  "socks-port": 0,
  "redir-port": 0,
  "tproxy-port": 0,
  "mixed-port": 0,
  "authentication": [],
  "skip-auth-prefixes": null,
  "allow-lan": false,
  "bind-address": "*",
  "lan-allowed-ips": [
    "0.0.0.0/0",
    "::/0"
  ],
  "lan-disallowed-ips": null,
  "mode": "rule",
  "unified-delay": false,
  "log-level": "info",
  "ipv6": true,
  "external-controller": "",
  "secret": "",
  "interface-name": "",
  "routing-mark": 0,
  "geo-auto-update": false,
  "geo-update-interval": 24,
  "geodata-loader": "memconservative",
  "tcp-concurrent": false,
  "find-process-mode": "strict",
  "global-ua": "clash.meta/1.10.0",
  "keep-alive-idle": 0,
  "keep-alive-interval": 0,
  "disable-keep-alive": false,
  "proxy-providers": {
    "remote": {
      "type": "http",
      "url": "https://example.test/sub",
      "interval": 3600,
      "path": "./providers/remote.yaml",
      "health-check": {
        "enable": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": 300
      }
    },
    "local": {
      "type": "file",
      "path": "./providers/local.yaml"
    },
    "inline": {
      "type": "inline",
      "payload": [
        {
          "name": "i1",
          "type": "socks5",
          "server": "192.0.2.3",
          "port": 1080
        }
      ]
    }
  },
  "rule-providers": {
    "ads": {
      "type": "http",
      "behavior": "domain",
      "format": "mrs",
      "url": "https://example.test/ads.mrs",
      "path": "./rules/ads.mrs",
      "interval": 86400
    },
    "custom": {
      "type": "inline",
      "behavior": "classical",
      "payload": [
        "DOMAIN-SUFFIX,custom.test"
      ]
    }
  },
  "sub-rules": {
    "extra": [
      "DOMAIN,sub.test,DIRECT",
      "MATCH,Select"
    ]
  },
  "proxies": [
    {
      "name": "a",
      "type": "socks5",
      "server": "192.0.2.1",
      "port": 1080
    },
    {
      "name": "b",
      "type": "http",
      "server": "192.0.2.2",
      "port": 8080
    }
  ],
  "proxy-groups": [
    {
      "name": "Select",
      "type": "select",
      "proxies": [
        "a",
        "b",
        "DIRECT",
        "Auto"
      ],
      "use": [
        "remote"
      ]
    },
    {
      "name": "Auto",
      "type": "url-test",
      "proxies": [
        "a",
        "b"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "lazy": true
    },
    {
      "name": "Fall",
      "type": "fallback",
      "proxies": [
        "a",
        "b"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300
    },
    {
      "name": "Balance",
      "type": "load-balance",
      "proxies": [
        "a",
        "b"
      ],
      "strategy": "consistent-hashing"
    },
    {
      "name": "Filtered",
      "type": "select",
      "include-all": true,
      "filter": "^a",
      "exclude-filter": "b"
    }
  ],
  "rule": [
    "DOMAIN,exact.test,DIRECT",
    "DOMAIN-SUFFIX,suffix.test,Select",
    "DOMAIN-KEYWORD,keyword,Fall",
    "DOMAIN-WILDCARD,*.wild.test,Balance",
    "DOMAIN-REGEX,^re[0-9]+\\.test$,REJECT",
    "GEOSITE,cn,DIRECT",
    "GEOIP,CN,DIRECT,no-resolve",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR6,fd00::/8,DIRECT,no-resolve",
    "SRC-IP-CIDR,192.168.1.0/24,Select",
    "DST-PORT,443,Select",
    "SRC-PORT,1000-2000,REJECT",
    "NETWORK,udp,DIRECT",
    "PROCESS-NAME,curl,DIRECT",
    "AND,((DOMAIN,and.test),(NETWORK,tcp)),Select",
    "OR,((DST-PORT,80),(DST-PORT,8080)),Select",
    "NOT,((DOMAIN-SUFFIX,not.test)),DIRECT",
    "RULE-SET,ads,REJECT",
    "RULE-SET,custom,Select",
    "SUB-RULE,(DOMAIN-SUFFIX,sub.test),extra",
    "MATCH,Select"
  ],
  "hosts": {},
  "dns": {
    "enable": false,
    "prefer-h3": false,
    "ipv6": false,
    "ipv6-timeout": 100,
    "use-hosts": true,
    "use-system-hosts": true,
    "respect-rules": false,
    "nameserver": [
      "https://doh.pub/dns-query",
      "tls://223.5.5.5:853"
    ],
    "fallback": null,
    "fallback-filter": {
      "geoip": false,
      "geoip-code": "",
      "ipcidr": [],
      "domain": null,
      "geosite": []
    },
    "fallback-lazy-query": false,
    "listen": "",
    "listen-routing-mark": 0,
    "enhanced-mode": "redir-host",
    "fake-ip-range": "198.18.0.1/16",
    "fake-ip-range6": "",
    "fake-ip-filter": [
      "dns.msftnsci.com",
      "www.msftnsci.com",
      "www.msftconnecttest.com"
    ],
    "fake-ip-filter-mode": "blacklist",
    "fake-ip-ttl": 1,
    "default-nameserver": [
      "114.114.114.114",
      "223.5.5.5",
      "8.8.8.8",
      "1.0.0.1"
    ],
    "cache-algorithm": "",
    "cache-max-size": 0,
    "nameserver-policy": null,
    "proxy-server-nameserver": null,
    "proxy-server-nameserver-policy": null,
    "direct-nameserver": null,
    "direct-nameserver-follow-policy": false
  },
  "tun": {
    "enable": false,
    "device": "",
    "stack": "Mips",
    "dns-mode": "",
    "dns-hijack": [
      "0.0.0.0:53"
    ],
    "auto-route": true,
    "auto-detect-interface": true
  },
  "sniffer": {
    "enable": false,
    "override-destination": true,
    "sniffing": null,
    "force-domain": [],
    "skip-src-address": null,
    "skip-dst-address": null,
    "skip-domain": [],
    "port-whitelist": [],
    "force-dns-mapping": true,
    "parse-pure-ip": true,
    "sniff": {}
  },
  "ntp": {
    "enable": false,
    "server": "time.apple.com",
    "port": 123,
    "interval": 30,
    "dialer-proxy": "",
    "write-to-system": false
  },
  "geox-url": {
    "mmdb": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb",
    "asn": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb",
    "geosite": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat"
  },
  "profile": {
    "store-selected": true,
    "store-fake-ip": false
  },
  "experimental": {
    "fingerprints": null,
    "quic-go-disable-gso": false,
    "quic-go-disable-ecn": true,
    "dialer-ip4p-convert": false
  },
  "tls": {
    "certificate": "",
    "private-key": "",
    "client-auth-type": "",
    "client-auth-cert": "",
    "ech-key": "",
    "custom-certifactes": null
  },
  "mitm": {
    "enable": false,
    "hostname": null,
    "skip-server-cert-verify": false,
    "url-rewrite": null,
    "header-rewrite": null,
    "body-rewrite": null,
    "map-local": null,
    "script": null,
    "h2": false,
    "limits": {}
  }
}
